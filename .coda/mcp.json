{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp",
        "--isolated",
        "--headless",
        "--output-dir",
        "output/temp/"
      ]
    },
    "jira": {
      "command": "npx",
      "args": [
        "-y",
        "@mcpio/jira"
      ],
      "env": {
        "JIRA_HOST": "${JIRA_HOST}",
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
      }
    }
  }
}